{
  "name": "chess-game",
  "module": "server.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "@types/bun": "latest",
    "tailwindcss": "^4.3.0"
  },
  "scripts": {
    "build:ts":      "bun run build.ts",
    "build:ts:prod": "bun run build.ts --prod",
    "build:css":     "bunx @tailwindcss/cli -i ./src/style.css -o ./dist/style.css",
    "build":         "bun run build:ts && bun run build:css",
    "build:prod":    "bun run build:ts:prod && bun run build:css",
    "build:analyze": "bun run build.analyze.ts",
    "watch:ts":      "bun build src/main.ts --outfile=dist/main.js --watch",
    "watch:css":     "bunx @tailwindcss/cli -i ./src/style.css -o ./dist/style.css --watch",
    "start":         "bun run server.ts",
    "test":          "bun test",
    "test:watch":    "bun test --watch"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
